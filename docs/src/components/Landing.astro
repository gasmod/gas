---
// The home page, laid out on full-width hairlines like a sheet of grid
// paper, with hatched margins outside the frame: the headline, a complete
// app beside what it does when run, and a grid of the modules with the
// interface each plugs in through.
import { Code } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const app = `package main

import (
	"context"
	"log"
	"net/http"

	"github.com/gasmod/gas"
)

func main() {
	app := gas.NewApp()

	app.Router().Handle(nil, http.MethodGet, "/", func(ctx gas.Context) error {
		return ctx.Text(http.StatusOK, "Hello, World!")
	})

	if err := app.Run(context.Background()); err != nil {
		log.Fatal(err)
	}
}`;

// What the app above prints and answers, from a real run.
const run = `$ go run .
INFO server started environment=development addr=0.0.0.0:8080

$ curl localhost:8080
Hello, World!`;

// Each module, what it does, and the interface it plugs in through: a core
// interface where the module implements one, else the module's own.
const modules = [
	{ name: 'config', iface: 'gas.ConfigProvider', text: 'Environment variables, .env, JSON and AWS Secrets Manager, bound to structs.' },
	{ name: 'log', iface: 'gas.Logger', text: 'Structured logging over slog or zerolog, with log shipping.' },
	{ name: 'database', iface: 'gas.DatabaseProvider', text: 'PostgreSQL, MySQL and SQLite, with transaction helpers.' },
	{ name: 'migrate', iface: 'gas.MigrationManager', text: 'Database migrations owned by the services that need them.' },
	{ name: 'auth', iface: 'gas.Principal', text: 'JWTs, sessions, API keys and single-use tokens.' },
	{ name: 'cache', iface: 'gas.CacheProvider', text: 'Key-value caching in memory or on Valkey.' },
	{ name: 'storage', iface: 'storage.Provider', text: 'Object storage on S3, a local directory or memory.' },
	{ name: 'queue', iface: 'gas.JobQueueProvider', text: 'Job queues on Amazon SQS or in memory.' },
	{ name: 'email', iface: 'gas.EmailProvider', text: 'Transactional email over Amazon SES or an in-memory outbox.' },
	{ name: 'template', iface: 'gas.TemplateProvider', text: 'Template storage in memory, a directory, an embedded FS or a database.' },
	{ name: 'ui', iface: 'ui.Provider', text: 'HTML pages with layouts, partials, static files and HTMX fragments.' },
];
---

<div class="gas-home not-content">
	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>

	<div class="gas-row">
		<div class="gas-frame">
			<p class="gas-home-note">github.com/gasmod/gas</p>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame">
			<h1 id="_top" class="gas-home-title">Build SaaS backends in Go without rebuilding the wiring.</h1>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame">
			<p class="gas-home-lede">
				Dependency injection, routing, middleware and a service lifecycle in the core. Add{' '}
				<a href={`${base}/reference/config/`}>config</a>,{' '}
				<a href={`${base}/reference/database/`}>database</a>,{' '}
				<a href={`${base}/reference/auth/`}>auth</a> and more as modules, only when you need them.
			</p>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame gas-home-actions">
			<a class="gas-pill gas-pill-dark" href={`${base}/start/installation/`}>Get started</a>
			<button class="gas-pill gas-pill-search" type="button" data-gas-search>
				<svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
					<circle cx="9" cy="9" r="5.5" />
					<path d="m13 13 3.5 3.5" />
				</svg>
				<span>Quick search</span>
				<kbd>⌘K</kbd>
			</button>
		</div>
	</div>

	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>

	<div class="gas-row">
		<div class="gas-frame gas-home-showcase">
			<div class="gas-home-code">
				<Code code={app} lang="go" title="main.go" />
			</div>
			<div class="gas-home-run">
				<Code code={run} lang="sh" frame="terminal" title="Terminal" wrap />
			</div>
		</div>
	</div>

	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>

	<div class="gas-row" id="modules">
		<div class="gas-frame">
			<h2 class="gas-home-heading">One core, eleven modules</h2>
			<p class="gas-home-text">
				Each module is its own Go module and registers as a service, like your own code. Most implement an
				interface the core defines, so your services depend on the interface, not the module.
			</p>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame gas-home-grid">
			<a class="gas-cell gas-cell-core" href={`${base}/reference/gas/`}>
				<span class="gas-cell-name">gas</span>
				<span class="gas-cell-text">The core: services, routing, handlers and middleware.</span>
				<span class="gas-cell-iface">gas.NewApp</span>
			</a>
			{
				modules.map((m) => (
					<a class="gas-cell" href={`${base}/reference/${m.name}/`}>
						<span class="gas-cell-name">{m.name}</span>
						<span class="gas-cell-text">{m.text}</span>
						<span class="gas-cell-iface">{m.iface}</span>
					</a>
				))
			}
		</div>
	</div>

	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>
</div>

<script>
	// The quick search pill opens the site's search dialog.
	document.querySelector('[data-gas-search]')?.addEventListener('click', () => {
		document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
	});
</script>
