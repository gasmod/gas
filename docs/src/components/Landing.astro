---
// The home page, laid out on full-width hairlines like a sheet of grid
// paper, with chevron margins outside the frame: the headline beside the
// core wired to its modules, a complete app beside what it does when run,
// and a grid of the modules with the interface each plugs in through.
import { Code } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const app = `package main

import (
	"context"
	"log"
	"net/http"

	"github.com/gasmod/gas"
)

func main() {
	app := gas.NewApp()

	app.Router().Handle(nil, http.MethodGet, "/", func(ctx gas.Context) error {
		return ctx.Text(http.StatusOK, "Hello, World!")
	})

	if err := app.Run(context.Background()); err != nil {
		log.Fatal(err)
	}
}`;

// What the app above prints and answers, from a real run.
const run = `$ go run .
INFO server started environment=development addr=0.0.0.0:8080

$ curl localhost:8080
Hello, World!`;

// Each module, what it does, and the interface it plugs in through: a core
// interface where the module implements one, else the module's own.
const modules = [
	{ name: 'config', iface: 'gas.ConfigProvider', text: 'Environment variables, .env, JSON and AWS Secrets Manager, bound to structs.' },
	{ name: 'log', iface: 'gas.Logger', text: 'Structured logging over slog or zerolog, with log shipping.' },
	{ name: 'database', iface: 'gas.DatabaseProvider', text: 'PostgreSQL, MySQL and SQLite, with transaction helpers.' },
	{ name: 'migrate', iface: 'gas.MigrationManager', text: 'Database migrations owned by the services that need them.' },
	{ name: 'auth', iface: 'gas.Principal', text: 'JWTs, sessions, API keys and single-use tokens.' },
	{ name: 'cache', iface: 'gas.CacheProvider', text: 'Key-value caching in memory or on Valkey.' },
	{ name: 'storage', iface: 'storage.Provider', text: 'Object storage on S3, a local directory or memory.' },
	{ name: 'queue', iface: 'gas.JobQueueProvider', text: 'Job queues on Amazon SQS or in memory.' },
	{ name: 'email', iface: 'gas.EmailProvider', text: 'Transactional email over Amazon SES or an in-memory outbox.' },
	{ name: 'template', iface: 'gas.TemplateProvider', text: 'Template storage in memory, a directory, an embedded FS or a database.' },
	{ name: 'ui', iface: 'ui.Provider', text: 'HTML pages with layouts, partials, static files and HTMX fragments.' },
];
---

<div class="gas-home not-content">
	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>

	<div class="gas-row">
		<div class="gas-frame gas-home-hero">
			<h1 id="_top" class="gas-home-title">Build SaaS backends in Go without rebuilding the wiring.</h1>
			<svg class="gas-wiring" viewBox="0 0 280 280" role="img" aria-label="The gas core wired to the config, log, database, auth, cache and queue modules">
				<path class="gas-wire" style="--i:0" d="M140 140 L140.0 35.0" pathLength="1"></path>
				<path class="gas-wire" style="--i:1" d="M140 140 L230.9 87.5" pathLength="1"></path>
				<path class="gas-wire" style="--i:2" d="M140 140 L230.9 192.5" pathLength="1"></path>
				<path class="gas-wire" style="--i:3" d="M140 140 L140.0 245.0" pathLength="1"></path>
				<path class="gas-wire" style="--i:4" d="M140 140 L49.1 192.5" pathLength="1"></path>
				<path class="gas-wire" style="--i:5" d="M140 140 L49.1 87.5" pathLength="1"></path>
				<circle class="gas-pulse" r="3.5" opacity="0">
					<animateMotion dur="6.0s" begin="1.4s" repeatCount="indefinite" path="M140.0 35.0 L140 140" keyPoints="0;1;1" keyTimes="0;0.2;1" calcMode="linear"></animateMotion>
					<animate attributeName="opacity" dur="6.0s" begin="1.4s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.03;0.17;0.22;1"></animate>
				</circle>
				<circle class="gas-pulse" r="3.5" opacity="0">
					<animateMotion dur="6.0s" begin="2.4s" repeatCount="indefinite" path="M230.9 87.5 L140 140" keyPoints="0;1;1" keyTimes="0;0.2;1" calcMode="linear"></animateMotion>
					<animate attributeName="opacity" dur="6.0s" begin="2.4s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.03;0.17;0.22;1"></animate>
				</circle>
				<circle class="gas-pulse" r="3.5" opacity="0">
					<animateMotion dur="6.0s" begin="3.4s" repeatCount="indefinite" path="M230.9 192.5 L140 140" keyPoints="0;1;1" keyTimes="0;0.2;1" calcMode="linear"></animateMotion>
					<animate attributeName="opacity" dur="6.0s" begin="3.4s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.03;0.17;0.22;1"></animate>
				</circle>
				<circle class="gas-pulse" r="3.5" opacity="0">
					<animateMotion dur="6.0s" begin="4.4s" repeatCount="indefinite" path="M140.0 245.0 L140 140" keyPoints="0;1;1" keyTimes="0;0.2;1" calcMode="linear"></animateMotion>
					<animate attributeName="opacity" dur="6.0s" begin="4.4s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.03;0.17;0.22;1"></animate>
				</circle>
				<circle class="gas-pulse" r="3.5" opacity="0">
					<animateMotion dur="6.0s" begin="5.4s" repeatCount="indefinite" path="M49.1 192.5 L140 140" keyPoints="0;1;1" keyTimes="0;0.2;1" calcMode="linear"></animateMotion>
					<animate attributeName="opacity" dur="6.0s" begin="5.4s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.03;0.17;0.22;1"></animate>
				</circle>
				<circle class="gas-pulse" r="3.5" opacity="0">
					<animateMotion dur="6.0s" begin="6.4s" repeatCount="indefinite" path="M49.1 87.5 L140 140" keyPoints="0;1;1" keyTimes="0;0.2;1" calcMode="linear"></animateMotion>
					<animate attributeName="opacity" dur="6.0s" begin="6.4s" repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.03;0.17;0.22;1"></animate>
				</circle>
				<g class="gas-node" style="--i:0"><rect x="111.0" y="23.0" width="58" height="24" rx="6"></rect><text x="140.0" y="39.0">config</text></g>
				<g class="gas-node" style="--i:1"><rect x="204.9" y="75.5" width="52" height="24" rx="6"></rect><text x="230.9" y="91.5">log</text></g>
				<g class="gas-node" style="--i:2"><rect x="194.9" y="180.5" width="72" height="24" rx="6"></rect><text x="230.9" y="196.5">database</text></g>
				<g class="gas-node" style="--i:3"><rect x="114.0" y="233.0" width="52" height="24" rx="6"></rect><text x="140.0" y="249.0">auth</text></g>
				<g class="gas-node" style="--i:4"><rect x="23.1" y="180.5" width="52" height="24" rx="6"></rect><text x="49.1" y="196.5">cache</text></g>
				<g class="gas-node" style="--i:5"><rect x="23.1" y="75.5" width="52" height="24" rx="6"></rect><text x="49.1" y="91.5">queue</text></g>
				<g class="gas-node gas-node-core"><rect x="106" y="123" width="68" height="34" rx="8"></rect><text x="140" y="145">gas</text></g>
			</svg>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame">
			<p class="gas-home-lede">
				Dependency injection, routing, middleware and a service lifecycle in the core. Add{' '}
				<a href={`${base}/reference/config/`}>config</a>,{' '}
				<a href={`${base}/reference/database/`}>database</a>,{' '}
				<a href={`${base}/reference/auth/`}>auth</a> and more as modules, only when you need them.
			</p>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame gas-home-actions">
			<a class="gas-pill gas-pill-dark" href={`${base}/start/installation/`}>Get started</a>
			<button class="gas-pill gas-pill-search" type="button" data-gas-search>
				<svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
					<circle cx="9" cy="9" r="5.5" />
					<path d="m13 13 3.5 3.5" />
				</svg>
				<span>Quick search</span>
				<kbd>⌘K</kbd>
			</button>
		</div>
	</div>

	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>

	<div class="gas-row">
		<div class="gas-frame gas-home-showcase">
			<div class="gas-home-code">
				<Code code={app} lang="go" title="main.go" />
			</div>
			<div class="gas-home-run">
				<Code code={run} lang="sh" frame="terminal" title="Terminal" wrap />
			</div>
		</div>
	</div>

	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>

	<div class="gas-row" id="modules">
		<div class="gas-frame">
			<h2 class="gas-home-heading">One core, eleven modules</h2>
			<p class="gas-home-text">
				Each module is its own Go module and registers as a service, like your own code. Most implement an
				interface the core defines, so your services depend on the interface, not the module.
			</p>
		</div>
	</div>
	<div class="gas-row">
		<div class="gas-frame gas-home-grid">
			<a class="gas-cell gas-cell-core" href={`${base}/reference/gas/`}>
				<span class="gas-cell-name">gas</span>
				<span class="gas-cell-text">The core: services, routing, handlers and middleware.</span>
				<span class="gas-cell-iface">gas.NewApp</span>
			</a>
			{
				modules.map((m) => (
					<a class="gas-cell" href={`${base}/reference/${m.name}/`}>
						<span class="gas-cell-name">{m.name}</span>
						<span class="gas-cell-text">{m.text}</span>
						<span class="gas-cell-iface">{m.iface}</span>
					</a>
				))
			}
		</div>
	</div>

	<div class="gas-row gas-row-gap"><div class="gas-frame"></div></div>
</div>

<script>
	// The quick search pill opens the site's search dialog.
	document.querySelector('[data-gas-search]')?.addEventListener('click', () => {
		document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
	});
</script>
