---
const { title } = Astro.locals.starlightRoute.entry.data;
const pageTitleId = '_top';
---

<div class="gas-page-heading">
	<h1 id={pageTitleId} data-page-title>{title}</h1>
	<button class="gas-copy-page" type="button" data-copy-page>
		<svg aria-hidden="true" viewBox="0 0 20 20" fill="none">
			<rect x="7" y="6" width="9" height="11" rx="1.5" />
			<path d="M13 6V4.5A1.5 1.5 0 0 0 11.5 3h-7A1.5 1.5 0 0 0 3 4.5v9A1.5 1.5 0 0 0 4.5 15H7" />
		</svg>
		<span data-copy-label>Copy page</span>
	</button>
</div>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-copy-page]');
	const label = button?.querySelector<HTMLElement>('[data-copy-label]');
	button?.addEventListener('click', async () => {
		if (!label) return;
		try {
			const title = document.querySelector<HTMLElement>('[data-page-title]');
			const article = document.querySelector<HTMLElement>('.sl-markdown-content');
			const content = article?.cloneNode(true) as HTMLElement | undefined;
			content?.querySelectorAll('button, .sl-anchor-link, script, style').forEach((element) => element.remove());

			let articleText = '';
			if (content && article) {
				content.style.position = 'fixed';
				content.style.left = '-10000px';
				content.style.top = '0';
				content.style.width = `${article.getBoundingClientRect().width}px`;
				content.style.opacity = '0';
				content.style.pointerEvents = 'none';
				content.setAttribute('aria-hidden', 'true');
				document.body.append(content);
				articleText = content.innerText.trim();
				content.remove();
			}

			const pageText = [title?.innerText.trim(), articleText].filter(Boolean).join('\n\n');
			if (!pageText) throw new Error('No page content found.');
			await navigator.clipboard.writeText(pageText);
			label.textContent = 'Copied';
		} catch {
			label.textContent = 'Copy failed';
		}
		window.setTimeout(() => {
			label.textContent = 'Copy page';
		}, 1600);
	});
</script>
