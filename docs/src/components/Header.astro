---
import Search from '@astrojs/starlight/components/Search.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SiteTitle from './SiteTitle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const onDocs = path === `${base}/` || path === base;
const onGuides = path.startsWith(`${base}/start/`);
const onModules = path.startsWith(`${base}/modules/`);
const onExamples = path === `${base}/project/examples/`;
const isGuidesPage = path === `${base}/start/introduction/`;
const isModulesPage = path === `${base}/modules/overview/`;
---

<div class="gas-header">
	<div class="gas-header-start">
		<SiteTitle />
		<nav class="gas-header-nav" aria-label="Primary navigation">
			<a href={`${base}/`} aria-current={onDocs ? 'page' : undefined}>Docs</a>
			<a class:active={onGuides} href={`${base}/start/introduction/`} aria-current={isGuidesPage ? 'page' : undefined}>Guides</a>
			<a class:active={onModules} href={`${base}/modules/overview/`} aria-current={isModulesPage ? 'page' : undefined}>Modules</a>
			<a href={`${base}/project/examples/`} aria-current={onExamples ? 'page' : undefined}>Examples</a>
		</nav>
	</div>
	<div class="gas-header-actions">
		<Search />
		<div class="gas-header-social sl-flex"><SocialIcons /></div>
		<div class="gas-header-theme sl-flex"><ThemeSelect /></div>
	</div>
</div>
