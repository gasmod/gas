---
// Replaces Starlight's SiteTitle to show the Gas icon and the documented
// release. The icon is served from public/ rather than through `logo`, which
// only accepts files Vite can import.
import { version } from '../lib/version';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const icon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/gas-icon.svg`;
---

<div class="sl-flex title-wrapper">
	<a href={siteTitleHref} class="site-title sl-flex">
		<img src={icon} alt="" width="32" height="32" />
		<span translate="no">{siteTitle}</span>
	</a>
	<span class="version" title="Documented release">{version}</span>
</div>

<style>
	.title-wrapper {
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}
	.site-title {
		align-items: center;
		gap: 0.6rem;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--gas-ink);
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.site-title span {
		overflow: hidden;
	}
	img {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 0.375rem;
	}
	.version {
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--gas-surface);
		color: var(--gas-body);
		font-size: 0.75rem;
		font-weight: 500;
		white-space: nowrap;
	}
</style>
